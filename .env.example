# SHREE SHAKTI BILLING - Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
# Central local MongoDB or LAN/Production MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/shree_shakti_billing

# Session Security
SESSION_SECRET=shree_shakti_super_secure_session_secret_key_2026_change_in_prod
SESSION_MAX_AGE_DAYS=7

# Initial Authorized Manager Seed Credentials
# Argon2 / Bcrypt will hash these during seed initialization.
# Passwords/PINs matching business standard: Hiren: 3112, Suresh: 1975
HIREN_INITIAL_PASSWORD=3112
SURESH_INITIAL_PASSWORD=1975

# PDF Storage
PDF_STORAGE_DIR=./storage/pdfs

# Optional Email Services (Leave empty or configure SMTP if needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shree Shakti Electric <noreply@shreeshaktielectric.com>"
